                            "header": [],
                            "cookie": [],
                            "body": "{\n    \"message\": \"Login successful\",\n    \"data\": {\n        \"user\": {\n            \"id\": 1,\n            \"name\": \"Admin User\",\n            \"email\": \"admin@example.com\",\n            \"role_id\": 1\n        },\n        \"token\": \"eyJ0eXAiOiJKV1QiLCJhbGc...\",\n        \"token_type\": \"bearer\",\n        \"expires_in\": 3600\n    }\n}"
