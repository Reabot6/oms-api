                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Premium Laptop - Updated\",\n    \"description\": \"High-performance laptop with latest specs - Now with extended warranty\",\n    \"price\": 1199.99,\n    \"sku\": \"LAPTOP-2024-001\",\n    \"quantity\": 45\n}"
