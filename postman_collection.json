                            "raw": "{{base_url}}/products/{{product_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["products", "{{product_id}}"]
                        },
                        "description": "Delete product (Admin/Vendor only, vendors can only delete their own products)"
