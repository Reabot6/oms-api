                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": "/path/to/products.csv"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/products/import",
                            "host": ["{{base_url}}"],
                            "path": ["products", "import"]
